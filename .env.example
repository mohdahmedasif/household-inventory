# The app reads exactly two variables. Both are optional.

# The port you open the app on (default 3000).
# PORT=3030

# A password for the app. Leave unset only on a network you trust:
# without it, anyone who can reach the port can open and edit the inventory.
# KEY=choose-a-long-random-string

# Everything else (Gemini API keys and models, defaults, expiry windows, app name)
# is set on the Settings page and stored in the database.
