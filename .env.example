# Gemini for photo → form extract on Add Product
GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default: gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest
# Used when the main model keeps returning 503/429 (default: gemini-flash-lite-latest).
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Waits between retries of the main model (ms, comma-separated) and sampling temperature.
# GEMINI_RETRY_DELAYS_MS=800,2000
# GEMINI_TEMPERATURE=0.2
# INVENTORY_GEMINI_API_KEY=

# Protects the REST API and web UI (Authorization: Bearer …).
# Leave unset only for local trusted use — the API is then open on that host.
INVENTORY_API_KEY=choose-a-long-random-string

# INVENTORY_API_HOST=0.0.0.0
# INVENTORY_API_PORT=3000
# INVENTORY_DATA_DIR=data

# Host port when using Docker Compose (maps to container :3000).
# INVENTORY_HOST_PORT=3030

# Largest photo accepted by Add Product, in megabytes.
# INVENTORY_MAX_UPLOAD_MB=8
# How alike two product names must be (0-1) to be suggested as the same product,
# within a category and across categories, and how many suggestions to show.
# INVENTORY_SIMILARITY=0.8
# INVENTORY_SIMILARITY_OTHER_CATEGORY=0.95
# INVENTORY_SIMILAR_LIMIT=3
# Entries shown in a product's History card.
# INVENTORY_HISTORY_LIMIT=100
